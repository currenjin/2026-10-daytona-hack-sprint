# External providers are disabled by default. Do not put credentials in this example.
# Copy locally to .env only when you are ready; .env is ignored.
PATCH_PROVIDER=local-rule
EXECUTION_PROVIDER=local
ALLOW_EXTERNAL_CALLS=0

# OpenAI-compatible chat-completions endpoint: configure only after external-call approval.
# LLM_BASE_URL=https://your-authorized-endpoint.example/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Daytona: no sandbox is created without explicit opt-in and valid configuration.
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_API_KEY=

# Load the local configuration explicitly:
# node --env-file=.env server.mjs
# npm run verify always defaults to a local verification; it is not a remote smoke test.
# Genuine remote smoke tests require separate user approval for keys, transfers and spend.
